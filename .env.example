# ===== Server =====
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ===== Database (MySQL / TiDB) =====
# Lokal (XAMPP): host=127.0.0.1, user=root, password=
# Produksi: TiDB Cloud (atau MySQL kompatibel lainnya)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sakura_dms
# DB_SSL=true   # aktifkan untuk TiDB Cloud (butuh koneksi SSL)

# ===== JWT =====
JWT_SECRET=ganti-dengan-rahasia-panjang-acak
JWT_EXPIRES_IN=1d

# ===== Upload =====
MAX_UPLOAD_MB=25

# ===== Supabase Storage (penyimpanan file dokumen) =====
# Ambil dari Supabase Dashboard → Project Settings → API
# PENTING: gunakan service_role key (bukan anon key) karena backend butuh
# akses penuh ke storage (upload/delete/signed URL) tanpa RLS user context.
# JANGAN pernah expose service_role key ke frontend/browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# ===== SAKURA AI Chatbot =====
GEMINI_API_KEY=gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=25000