# ===== Server =====
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ===== Database (MySQL) =====
# Lokal (XAMPP): host=127.0.0.1, user=root, password=
# Produksi: Azure Database for MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sakura_dms
# DB_SSL=true   # aktifkan untuk Azure MySQL

# ===== JWT =====
JWT_SECRET=ganti-dengan-rahasia-panjang-acak
JWT_EXPIRES_IN=1d

# ===== Upload =====
MAX_UPLOAD_MB=25

# ===== SAKURA AI Chatbot =====
GEMINI_API_KEY=gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=25000
